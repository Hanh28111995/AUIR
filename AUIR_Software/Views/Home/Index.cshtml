@using AUIR_Software.Helpers
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Home Page";
}
@{
    var contentList = ViewBag.ContentList as IEnumerable<Content>;
}

<div class="box">
    <div class="box-content">
        <div class="guide-icon">
            <div class="indicator-container">
                <div class="indicator-arrow top">
                    <div class="base"></div>
                    <div class="arrowpoint"></div>
                </div>
                <div class="indicator-arrow bottom">
                    <div class="base"></div>
                    <div class="arrowpoint"></div>
                </div>
            </div>
            <span>Scroll/Drag</span>
        </div>

        <section class="home-page page" id="Home">
            <div class="home-page-overlay">
            </div>
            <div class="home-page-content">
                @foreach (var content in contentList)
                {
                    if (content.SectionName == "Home")
                    {
                        var data = JsonConvert.DeserializeObject<SectionData>(content.RawJson) ?? new SectionData();

                        var item = data.Introduce[0];
                        {
                            @if (!string.IsNullOrEmpty(item.Title_p))
                            {
                                var title = item.Title_p.SplitAndFormat();                                                                
                                @for (int i = 0 ; i < title.Count(); i++)
                                {
                                    var title_break = title[i].Split(" ");
                                    <div class="wrap-limit-p">                                        
                                        @for (int j = 0; j < title_break.Count(); j++)
                                        {
                                            <h1>
                                                @if(i == 0){
                                                    <span class="text-existed">
                                                        @Html.Raw(title_break[j])
                                                    </span>
                                                }
                                                else{
                                                    <span class="text-removed">
                                                        @Html.Raw(title_break[j])
                                                    </span>
                                                }
                                            </h1>
                                        }
                                    </div>
                                }                             
                            }
                        }

                        <div class="title-3">
                            <img src="./asset/img/icon/li-icon.png" alt="AIUR Software" class="img-fluid" />
                            <div class="wrap-limit-p">                                
                                @for (int i = 1 ; i < data.Introduce.Count(); i++){
                                    if (!string.IsNullOrEmpty(data.Introduce[i].Title_p))                                        
                                        {
                                            var title = data.Introduce[i].Title_p.SplitAndFormat();                                                                                        
                                          @for( int j = 0;  j < title.Count(); j++){
                                            
                                            if(j%2 == 0) {
                                                <p class="text-existed-s">
                                                    @Html.Raw(title[j])
                                                </p>
                                                }
                                            else
                                            {
                                                <p class="text-removed-s">
                                                    @Html.Raw(title[j])
                                                </p>

                                            }   
                                           }
                                        }
                                    }                                                                                                                                          
                            </div>
                        </div>
                    }
                }                
            </div>

            <div id="video-background-container" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; overflow: hidden; background-color: #000;">
                <div id="video-background"></div>
            </div>

        </section>

        <div class="home-page-expand page-expand">
            <div class="home-page-expand-content">
                @foreach (var content in contentList)
                {
                    if (content.SectionName == "Home")
                    {
                        var data = JsonConvert.DeserializeObject<SectionData>(content.RawJson) ?? new SectionData();

                        var item = data.Introduce[0];
                        @Html.Raw(item.Describe_p)
                    }
                }
            </div>
            <a href="#">
                Project >
            </a>
        </div>
    </div>
</div>

