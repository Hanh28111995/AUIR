<div class="box">
    <div class="box-content">
        <section class="projects-page page" id="Project">
            <div class="projects-detail">
                @foreach (var content in contentList)
                {
                    if (content.SectionName == "Project")
                    {
                        var data = JsonConvert.DeserializeObject<SectionData>(content.RawJson) ?? new SectionData();

                        foreach (var item in data.List)
                        {
                            @if (!string.IsNullOrEmpty(item.Image) && !item.Image.Contains("placehold.co"))
                            {
                            <div class="projects-detail-item">
                                <div class="paralax" style="background-image: url('@item.Image')"></div>

                                <div class="projects-detail-item-content">
                                    @if (!string.IsNullOrEmpty(item.Title_c))
                                    {
                                        var titleParts = item.Title_c.SplitAndFormat(); // Trả về List<string>

                                        if (titleParts.Count > 0)
                                        {
                                            @* Phần tử đầu tiên luôn là h3 *@
                                            <h3>@titleParts[0]</h3>

                                            @* Các phần tử từ vị trí số 1 trở đi là thẻ p *@
                                            for (int i = 1; i < titleParts.Count; i++)
                                            {
                                                <p>@titleParts[i]</p>
                                            }
                                        }
                                    }

                                    <div class="describe-list">
                                        @if (!string.IsNullOrEmpty(item.Describe_c))
                                        {
                                            foreach (var tag in item.Describe_c.SplitAndFormat())
                                            {
                                                <div class="describe-list-item">
                                                    @tag
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                            }
                        }
                    }
                }
                              

                <div class="projects-detail-item " id="last-item">
                    <div class="paralax"></div>
                    <div class="projects-detail-item-content">


                        @foreach (var content in contentList)
                        {
                            if (content.SectionName == "Project")
                            {
                                var data = JsonConvert.DeserializeObject<SectionData>(content.RawJson) ?? new SectionData();

                                foreach (var item in data.List)
                                {
                                    @if (item.Image.Contains("placehold.co"))
                                    {                                        
                                            <div class="list">
                                                @if (!string.IsNullOrEmpty(item.Title_c))
                                                {
                                                    var titleParts = item.Title_c.SplitAndFormat(); 

                                                    if (titleParts.Count > 0)
                                                    {                                                        
                                                        <h3>@titleParts[0]</h3>                                                     
                                                        for (int i = 1; i < titleParts.Count; i++)
                                                        {
                                                            <p>@titleParts[i]</p>
                                                        }
                                                    }
                                                }
                                                <div class="describe-list">
                                                    @if (!string.IsNullOrEmpty(item.Describe_c))
                                                    {
                                                        foreach (var tag in item.Describe_c.SplitAndFormat())
                                                        {
                                                            <div class="describe-list-item">
                                                                @tag
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>                                        
                                    }
                                }
                            }
                        }                      
                       
                    </div>

                    <div class="see-all-projects">
                        <a href="#">
                            <span>See all projects</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right-short" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8" />
                            </svg>
                        </a>
                    </div>

                </div>
            </div>

            <div class="service-page ">
                <div class="service-title">
                    <h5>OUR SERVICE</h5>
                    <h3>Get your business online with our expertises</h3>
                </div>
            </div>
        </section>

    </div>
</div>

