<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AUIR Admin</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="./asset/css/AUIR_Software.styles.css" />

    <style>
        html{
            height: auto;
            overflow-y: auto;
            overflow-x: hidden;
        }
        body {
            background-color: #f4f7f6;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        #admin-wrapper {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-admin {
            background: #2c3e50;
            color: white;
        }

        .dashboard-card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div id="admin-wrapper">
        <nav class="navbar navbar-admin px-4 py-2 mb-4">
            <span class="navbar-brand mb-0 h1 text-white">AUIR Software Admin</span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex align-items-center">
                    <span class="me-3">Chào, <strong>@User.Identity.Name</strong></span>
                    <button class="btn btn-outline-light btn-sm" onclick="handleLogout()">Đăng xuất</button>
                </div>
            }
        </nav>

        <div class="container-fluid px-4">
            @RenderBody()
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Hàm đăng xuất dùng chung
        function handleLogout() {
            if(confirm("Bạn muốn đăng xuất?")) {
                $.post('/Admin/Logout', function() {
                    location.reload(); // Load lại trang để hiện Modal Login
                });
            }
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>