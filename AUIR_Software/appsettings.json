{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "LLM": {
    "Provider": "Gemini"
  },

  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com",
    "ApiVersion": "v1beta",
    "ChatModel": "gemini-3.8-flash",
    "EmbeddingModel": "gemini-embedding-2"
  },

  "Qdrant": {
    "Endpoint": "https://198de0fd-efe1-45fa-8e87-0d660d8a0798.australia-southeast1-0.gcp.cloud.qdrant.io:6333",
    "Collection": "aui_rag_collection"
  },
  "Rag": {
    "ChunkSize": 880,
    "ChunkOverlap": 120,
    "QdrantUpsertBatchSize": 100,
    "QdrantMaxRequestBytes": 2097152,
    "QdrantRequestTimeoutSeconds": 30,
    "GeminiRequestTimeoutSeconds": 30,
    "ProcessingTimeoutSeconds": 120,
    "UploadQueueCapacity": 2,
    "UploadQueuePath": "App_Data/rag-upload-queue",
    "GeminiThrottleDelayMs": 1000,
    "QdrantThrottleDelayMs": 100,
    "HttpMaxRetries": 2,
    "HttpRetryBaseDelayMs": 1000,
    "TopK": 5,
    "MinScore": 0.25
  }
}
